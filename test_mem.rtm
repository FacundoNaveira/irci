// Test Memoria
j inicio
.word 0
.word 0
.word 0

inicio:
    lci $t0, $zero, 0x0000 // Base User Space: 0x00000000
    addi $t1, $zero, 0xABCD
    ori $t1, $t1, 0x1234 // R2 = 0xABCD1234
    
    sw $t1, 0($t0)
    lhu $t2, 2($t0)
    sh $t1, 4($t0)
    lbu $t3, 4($t0)
    
    addi $t4, $zero, 8
    swx $t1, $t0, $t4
    lw $t5, 8($t0)
    
    trap 1
